# Banco de dados — Neon PostgreSQL em produção (use a connection string "pooled").
# Local: npm run db:start sobe um Postgres embutido em localhost:5433.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/usegazzeta"

# Auth.js — gere com: npx auth secret
AUTH_SECRET=
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# Usuária administradora criada pelo seed (npm run db:seed)
SEED_ADMIN_EMAIL="admin@usegazzeta.com.br"
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME="Administradora"

# Imagens — Vercel Blob (obrigatório em produção para upload de fotos)
BLOB_READ_WRITE_TOKEN=

# Alternativa: Cloudinary (não utilizado por padrão)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mostra o aviso "dados de demonstração" (defina false com o catálogo real)
NEXT_PUBLIC_DEMO_DATA=true
